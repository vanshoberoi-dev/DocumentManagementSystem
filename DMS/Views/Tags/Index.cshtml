@model List<DMS.Models.Contracts.Tags.TagResponse>
@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fa fa-tags me-2"></i>Tags</h2>
</div>

<div class="row g-3">
    <!-- Create Tag Form -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="fa fa-plus me-2 text-primary"></i>Create New Tag
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Tag Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="Name" class="form-control"
                               placeholder="Enter tag name" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-plus me-1"></i>Create Tag
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tags List -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="fa fa-list me-2 text-secondary"></i>All Tags
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tag Name</th>
                            <th>Normalized Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">
                                    <i class="fa fa-tags fa-2x mb-2 d-block"></i>
                                    No tags created yet
                                </td>
                            </tr>
                        }
                        @foreach (var tag in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary fs-6">@tag.Name</span>
                                </td>
                                <td class="text-muted small">@tag.Name.ToUpper()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>