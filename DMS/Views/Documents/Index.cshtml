@model DMS.Models.Contracts.PagedResult<DMS.Models.Contracts.Documents.DocumentListResponse>
@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fa fa-folder me-2"></i>Documents</h2>
    <a asp-controller="Documents" asp-action="Upload" class="btn btn-primary">
        <i class="fa fa-upload me-1"></i>Upload Document
    </a>
</div>

<!-- Search + Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">Search</label>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                       class="form-control" placeholder="Search by title or description..." />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Filter by Tag</label>
                <select name="tagId" class="form-select">
                    <option value="">All Tags</option>
                    @foreach (var tag in ViewBag.Tags as List<DMS.Models.Contracts.Tags.TagResponse> ?? new())
                    {
                        <option value="@tag.Id" selected="@(ViewBag.SelectedTagId?.ToString() == tag.Id.ToString())">
                            @tag.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fa fa-search me-1"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Documents Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Uploaded By</th>
                    <th>Tags</th>
                    <th>Size</th>
                    <th>Date</th>
                    <th>Access</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fa fa-folder-open fa-2x mb-2 d-block"></i>
                            No documents found
                        </td>
                    </tr>
                }
                @foreach (var doc in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Documents" asp-action="Details"
                               asp-route-id="@doc.Id" class="text-decoration-none fw-semibold">
                                @doc.Title
                            </a>
                        </td>
                        <td class="text-muted small">@doc.UploadedBy</td>
                        <td>
                            @foreach (var tag in doc.Tags)
                            {
                                <span class="badge bg-secondary me-1">@tag</span>
                            }
                        </td>
                        <td class="text-muted small">
                            @((doc.FileSize / 1024.0).ToString("F1")) KB
                        </td>
                        <td class="text-muted small">@doc.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-primary">@doc.AccessCount</span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Documents" asp-action="Details"
                               asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fa fa-eye"></i>
                            </a>
                            <a asp-controller="Documents" asp-action="Download"
                               asp-route-id="@doc.Id" class="btn btn-sm btn-outline-success me-1">
                                <i class="fa fa-download"></i>
                            </a>
                            <a asp-controller="Documents" asp-action="Edit"
                               asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="fa fa-edit"></i>
                            </a>
                            <form asp-controller="Documents" asp-action="Delete"
                                  asp-route-id="@doc.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this document?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-tagId="@ViewBag.SelectedTagId">
                    <i class="fa fa-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-tagId="@ViewBag.SelectedTagId">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-tagId="@ViewBag.SelectedTagId">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}