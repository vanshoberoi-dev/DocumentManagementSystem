@model List<DMS.Models.Contracts.Documents.VersionResponse>
@{
    ViewData["Title"] = "Version History";
    var documentId = ViewBag.DocumentId as Guid?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="fa fa-history me-2"></i>Version History
    </h2>
    <a asp-action="Details" asp-route-id="@documentId" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i>Back to Document
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Version</th>
                    <th>File Name</th>
                    <th>Size</th>
                    <th>Type</th>
                    <th>Uploaded By</th>
                    <th>Uploaded At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fa fa-folder-open fa-2x mb-2 d-block"></i>
                            No versions found
                        </td>
                    </tr>
                }
                @foreach (var version in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-success">v@version.VersionNumber</span>
                        </td>
                        <td class="fw-semibold">@version.FileName</td>
                        <td class="text-muted small">
                            @((version.FileSize / 1024.0).ToString("F1")) KB
                        </td>
                        <td class="text-muted small">@version.ContentType</td>
                        <td class="text-muted small">@version.UploadedBy</td>
                        <td class="text-muted small">
                            @version.UploadedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </td>
                        <td class="text-end">
                            <a asp-action="Download"
                               asp-route-id="@documentId"
                               asp-route-versionId="@version.Id"
                               class="btn btn-sm btn-outline-success">
                                <i class="fa fa-download me-1"></i>Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>