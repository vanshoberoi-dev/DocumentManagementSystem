@model DMS.Models.Contracts.Documents.UpdateDocumentRequest
@{
    ViewData["Title"] = "Edit Document";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="fa fa-edit me-2 text-secondary"></i>Edit Document
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="File" class="form-label fw-semibold">
                            Upload New Version
                        </label>
                        <input asp-for="File" type="file" class="form-control" />
                        <div class="form-text">
                            <i class="fa fa-info-circle me-1"></i>
                            Leave empty to keep current version. Uploading a new file creates a new version.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tags</label>
                        @if ((ViewBag.Tags as List<DMS.Models.Contracts.Tags.TagResponse>)?.Any() == true)
                        {
                            <div class="row g-2">
                                @foreach (var tag in ViewBag.Tags as List<DMS.Models.Contracts.Tags.TagResponse>)
                                {
                                    <div class="col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="TagIds" value="@tag.Id" id="tag_@tag.Id"
                                                   checked="@(Model.TagIds.Contains(tag.Id))" />
                                            <label class="form-check-label" for="tag_@tag.Id">
                                                @tag.Name
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">
                                <i class="fa fa-info-circle me-1"></i>
                                No tags available.
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}